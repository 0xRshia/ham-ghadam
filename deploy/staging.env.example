# Runtime file installed as /etc/hamghadam-stage/runtime.env (root-only).
# No production credentials or data are copied into staging.
APP_PORT=127.0.0.1:3100
APP_ORIGIN=https://stage.hmghadam.com
VINEXT_TRUST_PROXY=1
HOST_PHONES=
ADMIN_PHONES=
FAST_ADMIN_USERNAME=
FAST_ADMIN_PASSWORD_HASH=
SEED_SAMPLE_EVENTS=false
TEMP_LOGIN_ENABLED=false
SKIP_PAY_DEV=false
# Generate independent random values of at least 32 characters.
OTP_SECRET=
EMAIL_TOKEN_SECRET=
# Paid integrations and the automatic sheet scheduler stay inactive.
IDEKAVAN_API_KEY=
IDEKAVAN_SENDER=
ZARINPAL_MERCHANT_ID=
RESEND_API_KEY=
EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NOTIFICATION_JOB_SECRET=
EVENT_SYNC_JOB_SECRET=
EVENT_SYNC_IMAGE_HOSTS=
