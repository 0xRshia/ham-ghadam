[Unit]
Description=Back up the MVP SQLite database

[Service]
Type=oneshot
User=mvp
Group=mvp
EnvironmentFile=/etc/mvp/mvp.env
Environment=BACKUP_DIRECTORY=/var/backups/mvp
ExecStart=/opt/node/node-v22.23.2-linux-x64/bin/node /opt/mvp/current/scripts/backup-node.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mvp /var/backups/mvp
UMask=0077
