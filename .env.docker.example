# Copy to .env.docker. This file is passed to the container at runtime.
APP_PORT=3000
APP_ORIGIN=http://localhost:3000
# Set to 1 only behind a trusted HTTPS proxy that overwrites forwarded headers.
VINEXT_TRUST_PROXY=0
HOST_PHONES=
ADMIN_PHONES=
SEED_SAMPLE_EVENTS=false
TEMP_LOGIN_ENABLED=false
SKIP_PAY_DEV=false
# Generate a random secret of at least 32 characters; required even for test OTP.
OTP_SECRET=
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
ZARINPAL_MERCHANT_ID=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TOKEN_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NOTIFICATION_JOB_SECRET=
