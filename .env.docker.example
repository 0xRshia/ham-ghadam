# Copy to .env.docker. This file is passed to the container at runtime.
APP_PORT=3000
APP_ORIGIN=http://localhost:3000
# Set to 1 only behind a trusted HTTPS proxy that overwrites forwarded headers.
VINEXT_TRUST_PROXY=0
HOST_PHONES=
ADMIN_PHONES=
# Dedicated /fast credentials. Generate the hash with npm run fast:password.
FAST_ADMIN_USERNAME=
FAST_ADMIN_PASSWORD_HASH=
SEED_SAMPLE_EVENTS=false
TEMP_LOGIN_ENABLED=false
SKIP_PAY_DEV=false
# Generate a random secret of at least 32 characters; required even for test OTP.
OTP_SECRET=
IDEKAVAN_API_KEY=
IDEKAVAN_SENDER=
ZARINPAL_MERCHANT_ID=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TOKEN_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NOTIFICATION_JOB_SECRET=
# Independent secret shared by app and event-sync services (32+ random characters).
EVENT_SYNC_JOB_SECRET=
# Optional comma-separated exact HTTPS image hosts beyond public Google Drive.
EVENT_SYNC_IMAGE_HOSTS=
# Optional official Meta Business Discovery; manual avatar uploads work without it.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=
