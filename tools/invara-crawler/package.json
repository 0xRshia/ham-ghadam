{
  "name": "invara-crawler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "crawl": "node dist/cli.js",
    "snapshot": "node dist/snapshot.js",
    "supervise": "node dist/supervise.js",
    "viewer": "node dist/viewer.js",
    "crawl:events": "node dist/events/cli.js",
    "crawl:jabama": "node dist/events/cli.js --source jabama",
    "crawl:davvvat": "node dist/events/cli.js --source davvvat",
    "export:events": "node dist/events/cli.js --export-only",
    "test": "npm run build && node --test test/*.test.mjs",
    "lint": "eslint src test"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "eslint": "9.39.4",
    "typescript": "5.9.3"
  }
}
