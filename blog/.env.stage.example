# Copy to a root-owned runtime file outside the source release (mode 0600).
# Use only with compose.stage.yaml and project hmghadam-blog-stage.
BLOG_ORIGIN=https://blog-stage.hmghadam.com
BLOG_ADMIN_USERNAME=stage-blog-admin
# Generate a separate password with npm --prefix blog run password.
# Compose: keep raw $ characters; wrap the complete hash in single quotes.
# An empty hash disables login. Never copy production credentials here.
BLOG_ADMIN_PASSWORD_HASH=''
# Backend is loopback-only and nginx.stage.conf overwrites the trusted headers.
BLOG_TRUST_PROXY=1
