# Copy to blog/.env.local for development; use .env.production for Docker.
# Production public deployment must use https://hmghadam.com.
BLOG_ORIGIN=http://localhost:9090
# Optional in development; production requires an absolute path.
# Compose overrides this with /data backed by its isolated named volume.
# BLOG_DATA_DIR=/absolute/path/to/blog-data
BLOG_ADMIN_USERNAME=admin
# Run npm --prefix blog run password to generate the complete hash.
# Next .env.local: escape EVERY $ as \$; quotes alone do not prevent expansion.
# Compose .env.production: keep raw $ and wrap the complete hash in single quotes.
BLOG_ADMIN_PASSWORD_HASH=''
# Enable only behind Nginx which overwrites X-Real-IP, with loopback-bound backend.
BLOG_TRUST_PROXY=0
