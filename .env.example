# Copy to an ignored environment file or export these values in the service.
MVP_RUNTIME=node
DATABASE_PATH=/absolute/path/to/hmghadam.sqlite
MEDIA_PATH=/absolute/path/to/hmghadam-media
APP_ORIGIN=http://localhost:5173
# Browser map key restricted to allowed domains in the Neshan panel; never commit a real key.
NESHAN_MAP_KEY=
HOST_PHONES=
ADMIN_PHONES=
# Dedicated /fast credentials. Generate the hash with npm run fast:password.
FAST_ADMIN_USERNAME=
FAST_ADMIN_PASSWORD_HASH=
# Sample content and legacy demonstration shortcuts require explicit opt-in.
SEED_SAMPLE_EVENTS=false
TEMP_LOGIN_ENABLED=false
# When enabled: 09108624707 requires OTP 123456 and OTP_SECRET below.
# The legacy demo host 09108624708 still signs in without an OTP.
SKIP_PAY_DEV=false
# Set a random secret of at least 32 characters before enabling phone verification.
OTP_SECRET=
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
ZARINPAL_MERCHANT_ID=
# Optional verified email and browser push delivery; see docs/notifications.md.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TOKEN_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NOTIFICATION_JOB_SECRET=
# Independent secret shared by the app and event-sync worker (32+ random characters).
EVENT_SYNC_JOB_SECRET=
# Optional comma-separated exact HTTPS image hosts beyond public Google Drive.
EVENT_SYNC_IMAGE_HOSTS=
# Optional official Meta Business Discovery for professional organizer avatars.
# Requires authorized Facebook Login token + linked professional account; no anonymous scraping.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_ACCESS_TOKEN=
# Set an explicitly supported Graph version from your Meta app dashboard (e.g. v25.0).
INSTAGRAM_GRAPH_API_VERSION=
